771:   void write_file(const std::filesystem::path &path, std::span<const std::byte> values)
772:   {
773:     std::filesystem::create_directories(path.parent_path());
774:     std::ofstream out(path, std::ios::binary);
775:     if (!out)
776:     {
777:       throw std::runtime_error("failed to open " + path.string());
778:     }
779:     out.write(reinterpret_cast<const char *>(values.data()), static_cast<std::streamsize>(values.size()));
780:   }
781: 
782:   void write_text(const std::filesystem::path &path, const std::string &text)
783:   {
784:     std::filesystem::create_directories(path.parent_path());
785:     std::ofstream out(path, std::ios::binary);
786:     if (!out)
787:     {
788:       throw std::runtime_error("failed to open " + path.string());
789:     }
790:     out << text;
791:   }
