165:   std::vector<std::byte> bytes(std::initializer_list<unsigned int> values)
166:   {
167:     std::vector<std::byte> result;
168:     result.reserve(values.size());
169:     for (const auto value : values)
170:     {
171:       result.push_back(static_cast<std::byte>(value & 0xFFU));
172:     }
173:     return result;
174:   }
175: 
176:   std::vector<std::byte> repeated_bytes(std::uint8_t seed, std::size_t count)
177:   {
178:     std::vector<std::byte> result;
179:     result.reserve(count);
180:     for (std::size_t index = 0; index < count; ++index)
181:     {
182:       result.push_back(static_cast<std::byte>(static_cast<std::uint8_t>(seed + index)));
183:     }
