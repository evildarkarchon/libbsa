793:   void overwrite_u16(std::vector<std::byte> &values, std::size_t offset, std::uint16_t value)
794:   {
795:     if (offset + 2U > values.size())
796:     {
797:       throw std::runtime_error("BA2 DX10 mutation offset is out of range");
798:     }
799:     values[offset] = static_cast<std::byte>(value & 0xFFU);
800:     values[offset + 1U] = static_cast<std::byte>((value >> 8U) & 0xFFU);
801:   }
