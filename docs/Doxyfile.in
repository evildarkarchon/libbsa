PROJECT_NAME = libbsa
PROJECT_NUMBER = @PROJECT_VERSION@
OUTPUT_DIRECTORY = @CMAKE_CURRENT_BINARY_DIR@/docs/api
INPUT = @CMAKE_CURRENT_SOURCE_DIR@/include/libbsa @CMAKE_CURRENT_SOURCE_DIR@/docs/api-mainpage.md @CMAKE_CURRENT_SOURCE_DIR@/docs/thread-safety.md
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/docs/api-mainpage.md
RECURSIVE = YES
EXCLUDE = @CMAKE_CURRENT_SOURCE_DIR@/src @CMAKE_CURRENT_SOURCE_DIR@/TES5Edit @CMAKE_CURRENT_SOURCE_DIR@/tests @CMAKE_CURRENT_BINARY_DIR@
EXCLUDE_PATTERNS = */src/* */TES5Edit/* */tests/* */build/* */out/* */vcpkg_installed/*
GENERATE_HTML = YES
GENERATE_LATEX = NO
WARN_IF_UNDOCUMENTED = YES
WARN_AS_ERROR = NO
QUIET = NO
JAVADOC_AUTOBRIEF = YES
MARKDOWN_SUPPORT = YES
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = @CMAKE_CURRENT_SOURCE_DIR@
