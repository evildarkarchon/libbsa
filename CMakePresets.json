{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-debug-static",
      "displayName": "Windows MSVC Debug Static",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "LIBBSA_BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "windows-msvc-debug-shared",
      "displayName": "Windows MSVC Debug Shared",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "LIBBSA_BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "windows-msvc-release-static",
      "displayName": "Windows MSVC Release Static",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "LIBBSA_BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "windows-msvc-release-shared",
      "displayName": "Windows MSVC Release Shared",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "LIBBSA_BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "windows-msvc-asan-static",
      "displayName": "Windows MSVC AddressSanitizer Static",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "LIBBSA_BUILD_TESTS": "ON",
        "BUILD_SHARED_LIBS": "OFF",
        "LIBBSA_ENABLE_MSVC_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug-static",
      "configurePreset": "windows-msvc-debug-static",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-debug-shared",
      "configurePreset": "windows-msvc-debug-shared",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release-static",
      "configurePreset": "windows-msvc-release-static",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-release-shared",
      "configurePreset": "windows-msvc-release-shared",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-asan-static",
      "configurePreset": "windows-msvc-asan-static",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug-static",
      "configurePreset": "windows-msvc-debug-static",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug-shared",
      "configurePreset": "windows-msvc-debug-shared",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release-static",
      "configurePreset": "windows-msvc-release-static",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release-shared",
      "configurePreset": "windows-msvc-release-shared",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-asan-static",
      "configurePreset": "windows-msvc-asan-static",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
