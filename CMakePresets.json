{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "vcpkg",
      "description": "Configure libbsa with vcpkg manifest mode.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
